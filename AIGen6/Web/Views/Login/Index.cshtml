@{
    Layout = null;
}
   <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #ffffff;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                margin: 0;
            }

            .login-box {
                width: 350px;
                padding: 40px;
                border: 1px solid #dadce0;
                border-radius: 8px;
                text-align: center;
            }

            h2 {
                font-weight: normal;
                margin-bottom: 10px;
            }

            p {
                color: #202124;
                margin-bottom: 30px;
            }

            input {
                width: 100%;
                padding: 14px 12px;
                margin-bottom: 20px;
                border: 1px solid #dadce0;
                border-radius: 4px;
                font-size: 15px;
                box-sizing: border-box;
            }

                input:focus {
                    outline: 2px solid #1a73e8;
                    border-color: transparent;
                }

            button {
                background-color: #1a73e8;
                color: white;
                border: none;
                padding: 10px 24px;
                border-radius: 20px;
                cursor: pointer;
                font-size: 14px;
                float: right;
            }

                button:hover {
                    background-color: #1557b0;
                }

            .footer {
                margin-top: 60px;
                color: #5f6368;
                font-size: 12px;
            }
    </style>


    <div class="login-box">
        <h2>Connexion</h2>
        <p>Connectez-vous à votre compte</p>

        <form>
            <input type="text" name="login"
                   placeholder="Login" required>

            <input type="password" name="password"
                   placeholder="Password" required>

            <button type="submit">Suivant</button>
        </form>

     
    </div>
